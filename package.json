{
  "name": "relo",
  "version": "2.0.0",
  "description": "ReLo: 해외 직구 반품·교환·AS 클레임을 청구부터 실제 회수까지 기록하는 B2C 웹 서비스",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/main.mjs",
    "dev": "node --env-file-if-exists=.env --watch-path=src src/server/main.mjs",
    "dev:react": "vite",
    "build:react": "tsc --noEmit && vite build",
    "check": "node scripts/check.mjs",
    "lint": "biome check src scripts tests",
    "lint:fix": "biome check --write src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/http/**/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/**/*.test.mjs\"",
    "ai:smoke": "node --env-file-if-exists=.env scripts/ai-smoke.mjs",
    "mail:smoke": "node --env-file-if-exists=.env scripts/mail-smoke.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@uppy/core": "^6.3.0",
    "@uppy/dashboard": "^6.0.2",
    "@uppy/react": "^6.1.0",
    "@xyflow/react": "^12.12.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^2.3.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
